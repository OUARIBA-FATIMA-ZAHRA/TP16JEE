{
  "title": "Spring Boot Application Dashboard",
  "uid": "springboot-monitoring",
  "tags": ["spring-boot", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "Application Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "up{job=\"spring-boot-application\"}",
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "value": "1",
              "text": "UP",
              "color": "green"
            },
            {
              "type": "value",
              "value": "0",
              "text": "DOWN",
              "color": "red"
            }
          ]
        }
      }
    },
    {
      "title": "Requests per Second",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 4, "y": 0},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "reqps", "label": "Requests/sec"}, {"format": "short"}],
      "legend": {"show": true, "values": ["avg", "max"]}
    },
    {
      "title": "Response Time (95th Percentile)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "s", "label": "Seconds"}, {"format": "short"}],
      "legend": {"show": true, "values": ["avg", "max"]}
    },
    {
      "title": "JVM Heap Memory Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1048576",
          "legendFormat": "Used Memory (MB)",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"} / 1048576",
          "legendFormat": "Max Memory (MB)",
          "refId": "B"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "bytes", "label": "Memory (MB)"}, {"format": "short"}]
    },
    {
      "title": "GC Pause Duration",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m]) / rate(jvm_gc_pause_seconds_count[5m])",
          "legendFormat": "Average GC Pause",
          "refId": "A"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "s", "label": "Seconds"}, {"format": "short"}]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]) / rate(http_server_requests_seconds_count[5m])",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "percentunit", "label": "Error Rate"}, {"format": "short"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.1}
            ]
          }
        }
      }
    },
    {
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "system_cpu_usage",
          "legendFormat": "System CPU",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage",
          "legendFormat": "Process CPU",
          "refId": "B"
        }
      ],
      "xaxis": {"mode": "time"},
      "yaxes": [{"format": "percentunit", "label": "CPU Usage"}, {"format": "short"}]
    },
    {
      "title": "Custom Processing Counter",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "data_processing_total",
          "legendFormat": "Total Processed",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "title": "Processing Errors",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 24},
      "targets": [
        {
          "expr": "data_processing_errors",
          "legendFormat": "Total Errors",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "value": "0",
              "text": "No Errors",
              "color": "green"
            }
          ]
        }
      }
    }
  ]
}